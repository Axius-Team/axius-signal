{
  "name": "axius-signal",
  "version": "0.1.0",
  "description": "Open source error and log handling library for Node.js applications",
  "license": "Apache-2.0",
  "type": "commonjs",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
